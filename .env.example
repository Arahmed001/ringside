# Optional: enables Claude-powered search parsing, scouting reports, fight-preview articles and "Ask the data" (/ask).
# Without it, the app falls back to deterministic rules (everything still works).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Limits on what anonymous visitors can spend (search, scouting reports, previews). A refused call falls back to the rule-based answer.
# AI_DAILY_BUDGET=1000        model calls per UTC day for the whole site; 0 turns the model off
# AI_CLIENT_LIMIT=20          calls per visitor per window
# AI_CLIENT_WINDOW_MS=600000  the window (10 minutes)
# FORUM_AUTO_HIDE_REPORTS=6   how many different established people must report a forum post to hide it until an editor looks (2 or more; docs/forum.md)

# demo (default, fictional data) | licensed | file (a JSON feed, see lib/providers/file.ts)
BOXING_PROVIDER=demo
# BOXING_FILE=./sample-feed.json
# BOXING_API_URL=            optional; defaults to https://boxing-data-api.p.rapidapi.com
# BOXING_API_KEY=            the RapidAPI key (docs/real-data-readiness.md)
# BOXING_API_MAX_REQUESTS=90 request cap per load; the free tier is 100 a month
# BOXING_API_PER_HOUR=450 the plan's hourly request limit, with a margin (Mega: 500); vendor:backfill spaces its requests to stay under it
# BOXING_API_SINCE=2000-01-01
# BOXING_API_STORAGE_CONFIRMED=  unset: store provisionally (the default; every run says so). 1: the vendor confirmed in writing. 0: refuse to store
# Evaluate the feed first, without touching the database:  npm run vendor:sample -- --fights 10
# The first load and the daily update (use a NEW DATABASE_PATH for the real league): docs/real-data-runbook.md

# Headshots from Wikimedia Commons (real fighters only; the demo roster is fictional).
# WIKIMEDIA_CONTACT is required: Wikimedia asks bots to identify themselves with an email or URL.
# Run once by hand:  npm run media:resolve -- --limit 100
# Or resolve automatically after each ingest by setting MEDIA_RESOLVER=wikimedia.
# WIKIMEDIA_CONTACT=you@example.com
# MEDIA_RESOLVER=wikimedia
# MEDIA_RESOLVER_BATCH=100

# Pin "today" for reproducible runs and tests (the test suite sets this itself).
# RINGSIDE_NOW=2026-10-03

# Money research bot (docs/research.md). Your own email or website: it goes in the bot's User-Agent so site owners can reach you.
# RESEARCH_CONTACT=you@example.org

# Boxing news headlines (npm run news:refresh): the headline, a short excerpt and a link to the original, from outlets' public feeds. NEWS_CONTACT is an email or web page that goes in
# the User-Agent so an outlet can reach you; the refresh will not run without it. NEWS_NONCOMMERCIAL=1 is your statement that the site earns nothing; it adds the feeds of outlets
# (BBC, The Guardian, Sky Sports) that limit their feeds to non-commercial sites.
# NEWS_CONTACT=you@example.org
# NEWS_NONCOMMERCIAL=1
# The picture each outlet's own feed offers for a headline is saved by this site and shown from its own address (never loaded from the outlet). Unset: every open outlet's. `none` turns
# them all off; or list the outlet ids you keep (boxing-news, boxing-news-24, 15-rounds, world-boxing-news). An outlet left out has its saved pictures deleted at the next refresh.
# NEWS_IMAGE_SOURCES=boxing-news-24,world-boxing-news
# Official videos from promoters' and networks' YouTube channels: a key of your own for YouTube's Data API (free; docs/news.md says how). A secret: never commit it.
# YOUTUBE_API_KEY=   (or put it in the file ~/.ringside-youtube-key; docs/news.md)
# RESEARCH_DELAY_MS=3000
# RESEARCH_BLOCKLIST=site-that-asked-us-to-stop.example

# Public origin, used for canonical URLs, hreflang, sitemaps and share images. Set it in production.
# SITE_URL=https://ringside.example
# Where someone who is not signed in can report a mistake: an email address or an https:// page, published exactly as written (use a role address, not a personal one).
# Shown on the Data and Report pages. Set it before real data goes public; there is no default.
# SITE_CONTACT=corrections@ringside.example
# The name of a header your host sets to the visitor's real address and a visitor cannot choose (Fly.io: Fly-Client-IP). Set it on a host that does not overwrite X-Forwarded-For;
# the per-visitor limits then read that header alone. Leave it unset behind a proxy that overwrites X-Forwarded-For (docs/fly-deploy.md).
# CLIENT_IP_HEADER=Fly-Client-IP
# The sanctioning bodies' official lists (IBF, WBA, WBC, WBO) reach us through the vendor "sourced from BoxingScene". On a LICENSED feed they are left out (not fetched,
# not shown, even if already stored) until you set VENDOR_RANKINGS_CONFIRMED=1: your statement that the vendor's written answer allows storing and showing them.
# The demo league and a file feed always show them.
# VENDOR_RANKINGS_CONFIRMED=1
# The vendor's public licence terms (or the page that states the agreement). The Data page links it from the vendor credit when BOXING_PROVIDER=licensed.
# VENDOR_TERMS_URL=https://boxing-data.com/terms
# The public JSON API (/api/v1) and the embeds (/embed) are on for the demo league and a file feed (PUBLIC_API=0 turns them off). For a LICENSED feed they are
# off until you set BOTH: PUBLIC_API=1 and VENDOR_REDISTRIBUTION_CONFIRMED=1, which is your statement that the vendor's terms allow other sites to receive its data.
# PUBLIC_API=1
# VENDOR_REDISTRIBUTION_CONFIRMED=1
# The demo league is noindex until a real BOXING_PROVIDER is set; INDEXABLE=1 overrides that on purpose.
# INDEXABLE=1
# Where the SQLite file lives (default: data/ringside.db). Point it at a persistent volume in production.
# DATABASE_PATH=/data/ringside.db
# Model used by `npm run i18n:translate`; it has its own default in lib/i18n/translate.ts.
# ANTHROPIC_MODEL_TRANSLATE=
# Accounts (sign-in, server-side picks, community edits) live in their own SQLite file, by default next to DATABASE_PATH. Keep it on the persistent volume.
# ACCOUNTS_DB_PATH=/data/accounts.db

# Milliseconds between requests to Wikimedia Commons / Wikidata (defaults 250 and 1200; do not go faster than their guidance).
# WIKIMEDIA_GAP_MS=250
# WIKIDATA_GAP_MS=1200
# Days a vendor's career total may trail yesterday's result before the daily audit calls it a conflict (default 7; docs/real-data-runbook.md).
# VENDOR_LAG_DAYS=7
# The same for a load (it reads a cache that may be days old; default 14, else VENDOR_LAG_DAYS if set).
# VENDOR_LOAD_LAG_DAYS=14
# Where `npm run vendor:fetch` reads the API key from (default ~/.ringside-key, readable by you only; `npm run vendor:fetch -- --setup` creates it). Not for the app: only the fetch.
# RINGSIDE_KEY_FILE=/home/you/.ringside-key

# Capacity (docs/capacity.md). After another process (the nightly update) changes the data, the site keeps showing the old data and rebuilds once the data has
# stayed unchanged this many milliseconds (default 5000), so an update that commits several times causes one rebuild.
# RINGSIDE_WORLD_SETTLE_MS=5000
# How many seconds a share image may be reused by a browser, a CDN or a link-preview robot (default 600; 0 = always ask), and the megabytes of drawn share images
# (default 24) and of compressed sitemap files (default 32) the server keeps in memory (0 = keep none).
# RINGSIDE_OG_MAX_AGE=600
# RINGSIDE_OG_CACHE_MB=24
# RINGSIDE_SITEMAP_CACHE_MB=32

# The optional in-container nightly job (docs/nightly.md): for a host with no cron that can reach the data volume (Render, Fly, Railway). Off unless NIGHTLY_SCHEDULE is set.
# The time of day to run it, HH:MM in UTC (24 hours). A few minutes of random jitter are added. The job needs BOXING_API_KEY (and BOXING_API_STORAGE_CONFIRMED) in the same environment.
# NIGHTLY_SCHEDULE=03:30
# How many nightly backups to keep (default 7; whole days of history, newest first). Only dated folders under <data>/backups made by the tool are ever removed.
# NIGHTLY_KEEP=7
# A command that copies the new backup off the host. It runs through `sh -c` with the backup folder as its one argument, with a timeout, and without the vendor and AI keys.
# Its failure is reported in the status file and the log, and never stops the update. The image has no rclone, scp or rsync: the command has to exist in your image.
# NIGHTLY_OFFSITE_CMD=/app/copy-backup.sh
# NIGHTLY_OFFSITE_TIMEOUT_MIN=30
# Minutes of random delay added to NIGHTLY_SCHEDULE (default 5, 0 to 60).
# NIGHTLY_JITTER_MIN=5
# Public sources the nightly job looks at for changes, stored as proposals for an administrator (docs/nightly.md section 2b): champions, champions:nightly or champions:weekly (Mondays, UTC).
# Needs WIKIMEDIA_CONTACT. A failed look is only a warning. Empty: nothing is watched.
# WATCH_SOURCES=champions:weekly

# Have the nightly job refresh the boxing headlines and official videos (needs NEWS_CONTACT below; videos need YOUTUBE_API_KEY). A failure is a warning, not a failed night.
# NEWS_REFRESH=1
# The vendor update gate (docs/vendor-gate-plan.md). observe = record what each daily update changed in rows we hold, and what would wait for approval, in <data>/gate-reports/ and the log; it holds nothing.
# hold = HOLD those changes for an administrator (/review/updates): they are put back before the update commits and become proposals; a night over the flood guard is refused (exit 3).
# Leave empty (off) until you want it. Use observe first and tune the flood-guard numbers below on real nights:
# VENDOR_GATE=observe
# VENDOR_GATE_MAX_FIELD_SHARE=0.3
# VENDOR_GATE_MAX_FIELD_ROWS=100
# VENDOR_GATE_MAX_NIGHT=2000
# How many days the oldest change waiting for an administrator may wait before /api/health shows updatesOverdueDays and the doctor warns (default 7). While changes wait the site shows the last approved data.
# UPDATES_OVERDUE_DAYS=7
# How many days a rejected source change is remembered before it is raised once more (default 30).
# PROPOSAL_REJECT_MEMORY_DAYS=30
# Node options for the update process (not the site): default --max-old-space-size=768. MALLOC_ARENA_MAX is set to 2 for it unless you set it.
# NIGHTLY_NODE_OPTIONS=--max-old-space-size=768

# Check all of this (and the files it points to) before the first visitor:  npm run doctor -- --production
